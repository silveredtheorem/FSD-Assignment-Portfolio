# port the Express server listens on
PORT=5050

# origin allowed to make cross-origin requests (the React dev server)
ALLOWED_ORIGIN=http://localhost:5173

# absolute base URL used to build links to statically-served project images.
# leave unset to fall back to the request's own protocol/host.
BASE_URL=http://localhost:5050

# path to the JSON file where contact form submissions are persisted
CONTACTS_DATA_FILE=./data/contacts.json
